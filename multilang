        [STAThread]
        static void Main(string[] args)
        {
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);

            
            if (!EsAdministrador())
            {
                ProcessStartInfo proc = new ProcessStartInfo();
                proc.UseShellExecute = true;
                proc.WorkingDirectory = Environment.CurrentDirectory;
                proc.FileName = Application.ExecutablePath;
                if (args.Length > 0) proc.Arguments = string.Join(" ", args);
                proc.Verb = "runas";
                try { Process.Start(proc); } catch { }
                return;
            }

            InicializarDiccionario();

            bool modoJuego = false;
            foreach (string arg in args) { if (arg.ToLower() == "-modojuego") modoJuego = true; }

            
            List<string> todasLasRutas = new List<string>();

            string idiomaSeleccionado = "Español";
            RegistryKey keyRead = Registry.CurrentUser.OpenSubKey(RegKeyPath);
            if (keyRead != null)
            {
                idiomaSeleccionado = (string)keyRead.GetValue("Idioma", "Español");
                keyRead.Close();
            }


//parte 7
            
            if (!modoJuego && Registry.CurrentUser.OpenSubKey(RegKeyPath) == null)
            {
                Form formLang = new Form() {
                    Text = "Language / Idioma", Width = 350, Height = 180,
                    StartPosition = FormStartPosition.CenterScreen, FormBorderStyle = FormBorderStyle.FixedDialog,
                    MaximizeBox = false, MinimizeBox = false, TopMost = true
                };
                Label lbl = new Label() { Text = "Select language / Selecciona tu idioma:", Left = 20, Top = 20, Width = 300 };
                ComboBox combo = new ComboBox() { Left = 20, Top = 50, Width = 290, DropDownStyle = ComboBoxStyle.DropDownList };
                foreach (var l in IdiomasDisponibles) combo.Items.Add(l);
                combo.SelectedIndex = 0;
                Button btn = new Button() { Text = "OK", Left = 120, Top = 95, Width = 100, DialogResult = DialogResult.OK };
                formLang.Controls.AddRange(new Control[] { lbl, combo, btn });
                formLang.AcceptButton = btn;

                if (formLang.ShowDialog() == DialogResult.OK) {
                    idiomaSeleccionado = combo.SelectedItem.ToString();
                } else { return; }
            }

            Textos Txt = Diccionario[idiomaSeleccionado];
            string archivoTraduccionOrigen = MapeoArchivos[idiomaSeleccionado];

            
            if (idiomaSeleccionado == "Español") AccesoDirectoNombre = "TERA Europe Classic+ Español.lnk";
            else if (idiomaSeleccionado == "Français (Francés)") AccesoDirectoNombre = "TERA Europe Classic+ Français.lnk";
            else if (idiomaSeleccionado == "Deutsch (Alemán)") AccesoDirectoNombre = "TERA Europe Classic+ Deutsch.lnk";
            else if (idiomaSeleccionado == "Polski (Polaco)") AccesoDirectoNombre = "TERA Europe Classic+ Polski.lnk";
            else if (idiomaSeleccionado == "Русский (Ruso)") AccesoDirectoNombre = "TERA Europe Classic+ Русский.lnk";
            else if (idiomaSeleccionado == "Português (Brasil)") AccesoDirectoNombre = "TERA Europe Classic+ Português.lnk";
            else if (idiomaSeleccionado == "Svenska (Sueco)") AccesoDirectoNombre = "TERA Europe Classic+ Svenska.lnk";
            else AccesoDirectoNombre = "TERA Europe Classic+ Multilang.lnk";

            string escritorioPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Desktop), AccesoDirectoNombre);

            string rutaData = "";
            string rutaLauncher = "";

            keyRead = Registry.CurrentUser.OpenSubKey(RegKeyPath);
            if (keyRead != null)
            {
                rutaData = (string)keyRead.GetValue("RutaData", "");
                rutaLauncher = (string)keyRead.GetValue("RutaLauncher", "");
                keyRead.Close();
            }


//parte8
            
            if (!string.IsNullOrEmpty(rutaData) && Directory.Exists(rutaData) && !modoJuego)
            {
                DialogResult res = MessageBox.Show(Txt.Menu_YaInst, Txt.Titulo, MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question, MessageBoxDefaultButton.Button1, MessageBoxOptions.ServiceNotification);
                if (res == DialogResult.Cancel) return;
                if (res == DialogResult.No)
                {
                    RestaurarArchivosOriginales(rutaData);
                    Registry.CurrentUser.DeleteSubKeyTree(RegKeyPath, false);
                    if (File.Exists(escritorioPath)) File.Delete(escritorioPath);
                    MessageBox.Show(Txt.Des_Exito, Txt.Titulo, MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button1, MessageBoxOptions.ServiceNotification);
                    return;
                }
            }

            
            if (string.IsNullOrEmpty(rutaData) || string.IsNullOrEmpty(rutaLauncher) || !Directory.Exists(rutaData) || !File.Exists(rutaLauncher))
            {
                MessageBox.Show(Txt.Bienvenida, Txt.Titulo, MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button1, MessageBoxOptions.ServiceNotification);
                MessageBox.Show(Txt.Paso1_Msg, Txt.Paso1_Tit, MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button1, MessageBoxOptions.ServiceNotification);

                // Dueño invisible para clavar el buscador de carpetas al frente
                Form formDueño = new Form() { TopMost = true, StartPosition = FormStartPosition.CenterScreen, Width = 0, Height = 0, FormBorderStyle = FormBorderStyle.None };
                formDueño.Show();
                FolderBrowserDialog fbd = new FolderBrowserDialog() { Description = Txt.Paso1_Desc };
                if (fbd.ShowDialog(formDueño) == DialogResult.OK) {
                    rutaData = Path.Combine(fbd.SelectedPath, "S1Game", "S1Data");
                } else { formDueño.Close(); return; }
                formDueño.Close();

                if (!Directory.Exists(rutaData)) {
                    MessageBox.Show(Txt.Err_Valid, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button1, MessageBoxOptions.ServiceNotification);
                    return;
                }


//parte9                
                MessageBox.Show(Txt.Paso2_Msg, Txt.Paso2_Tit, MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button1, MessageBoxOptions.ServiceNotification);
                
                // Dueño invisible para clavar el buscador de archivos al frente
                Form formDueñoL = new Form() { TopMost = true, StartPosition = FormStartPosition.CenterScreen, Width = 0, Height = 0, FormBorderStyle = FormBorderStyle.None };
                formDueñoL.Show();
                OpenFileDialog ofd = new OpenFileDialog() { Filter = "Launcher (*.exe)|*.exe", Title = Txt.Paso2_Tit, FileName = NombreLauncher };
                if (ofd.ShowDialog(formDueñoL) == DialogResult.OK) {
                    rutaLauncher = ofd.FileName;
                } else { formDueñoL.Close(); return; }
                formDueñoL.Close();

                if (Path.GetFileName(rutaLauncher).ToLower() != NombreLauncher.ToLower()) {
                    MessageBox.Show(Txt.Err_Launch, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button1, MessageBoxOptions.ServiceNotification);
                    return;
                }

                RegistryKey keyWrite = Registry.CurrentUser.CreateSubKey(RegKeyPath);
                keyWrite.SetValue("RutaData", rutaData);
                keyWrite.SetValue("RutaLauncher", rutaLauncher);
                keyWrite.SetValue("Idioma", idiomaSeleccionado);
                keyWrite.Close();

                try {
                    CrearAccesoDirecto(escritorioPath, Application.ExecutablePath, "-modojuego", Txt.Lnk_Desc, rutaLauncher);
                    MessageBox.Show(Txt.Lnk_Exito, Txt.Titulo, MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button1, MessageBoxOptions.ServiceNotification);
                } catch { }
            }

            
            todasLasRutas.Clear();
            todasLasRutas.Add(rutaData);
            try { 
                todasLasRutas.AddRange(Directory.GetDirectories(rutaData, "*", SearchOption.AllDirectories)); 
            } catch { }


//parte 10            
            
            if (File.Exists(rutaLauncher)) {
                Process.Start(rutaLauncher);
            } else {
                MessageBox.Show(Txt.Err_NoLaunch, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button1, MessageBoxOptions.ServiceNotification);
                return;
            }

            
            MessageBox.Show(
                Txt.Espera_Lnch, 
                Txt.Titulo, 
                MessageBoxButtons.OK, 
                MessageBoxIcon.Warning, 
                MessageBoxDefaultButton.Button1, 
                MessageBoxOptions.ServiceNotification
            );


 //parte11
            
            bool cambiosRealizados = false;
            foreach (string sub in todasLasRutas)
            {
                string eur = Path.Combine(sub, "DataCenter_Final_EUR.dat");
                string origen = Path.Combine(sub, archivoTraduccionOrigen);
                try {
                    if (File.Exists(eur)) File.Delete(eur);
                    if (File.Exists(origen)) {
                        File.Copy(origen, eur, true);
                        cambiosRealizados = true;
                    }
                } catch {
                    MessageBox.Show(Txt.Err_Disco, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error, MessageBoxDefaultButton.Button1, MessageBoxOptions.ServiceNotification);
                    return;
                }
            }

//parte 12
            
            if (cambiosRealizados) {
                MessageBox.Show(Txt.Exito_Final, Txt.Titulo, MessageBoxButtons.OK, MessageBoxIcon.Information, MessageBoxDefaultButton.Button1, MessageBoxOptions.ServiceNotification);
            } else {
                MessageBox.Show(Txt.No_Cambios, Txt.Titulo, MessageBoxButtons.OK, MessageBoxIcon.Warning, MessageBoxDefaultButton.Button1, MessageBoxOptions.ServiceNotification);
            }
            Environment.Exit(0);
        }

        static bool EsAdministrador()
        {
            var identity = System.Security.Principal.WindowsIdentity.GetCurrent();
            var principal = new System.Security.Principal.WindowsPrincipal(identity);
            return principal.IsInRole(System.Security.Principal.WindowsBuiltInRole.Administrator);
        }

        static void RestaurarArchivosOriginales(string rutaBaseData)
        {
            if (!Directory.Exists(rutaBaseData)) return;
            List<string> rutas = new List<string> { rutaBaseData };
            try { rutas.AddRange(Directory.GetDirectories(rutaBaseData, "*", SearchOption.AllDirectories)); } catch { }
            foreach (string sub in rutas)
            {
                string eur = Path.Combine(sub, "DataCenter_Final_EUR.dat");
                string bak = Path.Combine(sub, "DataCenter_Final_EUR.bak");
                if (File.Exists(bak)) {
                    File.Copy(bak, eur, true);
                    File.Delete(bak);
                }
            }
        }

        static void CrearAccesoDirecto(string pathLnk, string target, string args, string desc, string iconPath)
        {
            Type t = Type.GetTypeFromCLSID(new Guid("72C24DD5-D70A-438B-8A42-98424B88AFB8"));
            dynamic shell = Activator.CreateInstance(t);
            var lnk = shell.CreateShortcut(pathLnk);
            lnk.TargetPath = target;
            lnk.Arguments = args;
            lnk.Description = desc;
            lnk.WorkingDirectory = Path.GetDirectoryName(target);
            if (File.Exists(iconPath)) lnk.IconLocation = iconPath + ",0";
            lnk.Save();
        }
    }
